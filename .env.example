# Supabase (client-side/publishable values — safe to expose in the browser bundle)
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Optional integrations (all no-op when empty)
VITE_LINKEDIN_CLIENT_ID=""
VITE_SENTRY_DSN=""
VITE_POSTHOG_KEY=""

# Server-side secrets (GEMINI_API_KEY, STRIPE_SECRET_KEY, RESEND_API_KEY,
# LINKEDIN_CLIENT_SECRET) are NOT set here — they live in Supabase:
#   supabase secrets set GEMINI_API_KEY=...
